// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "cli_default_open_behavior": "existing_window",
    "disable_ai": true,
    "show_completions_on_input": true,
    "show_completion_documentation": true,
    "inlay_hints": {
        "enabled": true,
    },

    "icon_theme": {
        "mode": "dark",
        "light": "VSCode Icons for Zed (Dark Official Icons)",
        "dark": "VSCode Icons for Zed (Dark Official Icons)",
    },

    "agent": {
        "enabled": false,
        "button": false,
        "favorite_models": [],
        "model_parameters": [],
    },
    "file_types": {
        "jsonc": [".postcssrc"],
        "dockerfile": ["Dockerfile-dev"],
    },
    "auto_indent_on_paste": true,
    "soft_wrap": "none",
    "tab_size": 4,
    "agent_servers": {
        "github-copilot-cli": {
            "type": "registry",
        },
        "claude-acp": {
            "type": "registry",
        },
    },
    "base_keymap": "VSCode",
    "ui_font_size": 13,
    "buffer_font_size": 12,
    "buffer_font_weight": 500,
    "ui_font_family": "JetBrains Mono",
    "buffer_font_family": "JetBrains Mono",
    "buffer_font_features": {
        "calt": false, // Disable ligatures
    },

    "theme": {
        "mode": "dark",
        "light": "Aura Soft Dark",
        "dark": "Brogrammer",
    },
    "languages": {
        "Python": {
            "code_actions_on_format": {
                "source.organizeImports.ruff": true,
            },
            "formatter": {
                "language_server": {
                    "name": "ruff",
                },
            },
        },
        "JavaScript": {
            "formatter": [],
            "code_actions_on_format": {
                "source.fixAll.eslint": true,
            },
        },
        "TSX": {
            "formatter": [],
            "language_servers": ["typescript-language-server", "!vtsls"],
            "show_completions_on_input": true,
            "show_completion_documentation": true,
            "code_actions_on_format": {
                "source.fixAll.eslint": true,
            },
        },
        "TypeScript": {
            "formatter": [],
            "language_servers": ["typescript-language-server", "!vtsls"],
            "code_actions_on_format": {
                "source.fixAll.eslint": true,
            },
        },
    },
    "project_panel": {
        "dock": "left",
        "indent_size": 16,
    },
    "theme_overrides": {
        "Aura Dark": {
            "editor.document_highlight.read_background": "#00000000",
            "editor.document_highlight.write_background": "#00000000",
            "border.variant": "#15141C",
            "border": "#15141C",
            "title_bar.background": "#15141C",
            "panel.background": "#15141C",
            "panel.focused_border": "#4E466E",
            "players": [
                {
                    "cursor": "#BD9DFF",
                },
            ],
            "syntax": {
                "comment": {
                    "font_style": "italic",
                },
                "comment.doc": {
                    "font_style": "italic",
                },
            },
        },
    },
}
